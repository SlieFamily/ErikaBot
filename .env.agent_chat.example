# Copy this file to .env.agent_chat (read directly by this plugin), or use environment variables.
# .env.prod is tracked in this repository: DO NOT put credentials there.
AGENT_CHAT_ENABLED=false
AGENT_CHAT_GROUPS=[123456789]
AGENT_CHAT_PRIVATE_USERS=[]
AGENT_CHAT_DSH_URL=http://127.0.0.1:3080
# Choose one. The browser-session cookie is privileged, never share it in QQ.
AGENT_CHAT_DSH_TOKEN=
AGENT_CHAT_DSH_COOKIE=
AGENT_CHAT_STATE_PATH=data/agent_chat/state.sqlite3
AGENT_CHAT_TAKEOVER_MENTIONS=true
AGENT_CHAT_AMBIENT_PROBABILITY=0
AGENT_CHAT_COOLDOWN=8
AGENT_CHAT_DEBOUNCE=2
AGENT_CHAT_MAX_CALLS_PER_HOUR=30
AGENT_CHAT_TIMEOUT=90
# Leave both empty to use the model configured in DSH.
AGENT_CHAT_PROVIDER=
AGENT_CHAT_MODEL=

# Requires a vision-capable DSH model with input: [text, image].
AGENT_CHAT_IMAGES_ENABLED=false
AGENT_CHAT_IMAGE_COUNT=2
AGENT_CHAT_IMAGE_MAX_BYTES=8000000
AGENT_CHAT_IMAGE_MAX_PIXELS=20000000
# Optional exact QQ image-cache directories; [] forbids local file reads.
AGENT_CHAT_IMAGE_CACHE_ROOTS=[]

# Group-only idle speech; [] follows the main group allowlist.
AGENT_CHAT_PROACTIVE_ENABLED=false
AGENT_CHAT_PROACTIVE_GROUPS=[]
AGENT_CHAT_PROACTIVE_IDLE=900
AGENT_CHAT_PROACTIVE_DAILY_LIMIT=6
AGENT_CHAT_PROACTIVE_RECENT_HOURS=6
# Quiet hours affect random/proactive replies, not direct mentions.
AGENT_CHAT_QUIET_START=23
AGENT_CHAT_QUIET_END=9
AGENT_CHAT_UTC_OFFSET_HOURS=8
