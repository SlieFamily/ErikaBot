# Copy this file to .env.agent_chat (read directly by this plugin), or use environment variables.
# .env.prod is tracked in this repository: DO NOT put credentials there.
AGENT_CHAT_ENABLED=false
AGENT_CHAT_GROUPS=[123456789]
AGENT_CHAT_PRIVATE_USERS=[]
AGENT_CHAT_DSH_URL=http://127.0.0.1:3080
# Choose one. The browser-session cookie is privileged, never share it in QQ.
AGENT_CHAT_DSH_TOKEN=
AGENT_CHAT_DSH_COOKIE=
AGENT_CHAT_STATE_PATH=data/agent_chat/state.sqlite3
# Optional structured memory and reviewed slang; run the private setup helper first.
AGENT_CHAT_MEMORY_ENABLED=false
# Defaults for new groups; SUPERUSER commands persist overrides without restarting.
AGENT_CHAT_MEMORY_IMMEDIATE_ENABLED=true
AGENT_CHAT_MEMORY_BACKGROUND_ENABLED=false
AGENT_CHAT_MEMORY_BATCH_THRESHOLD=30
AGENT_CHAT_MEMORY_INTERVAL=600
AGENT_CHAT_MEMORY_MIN_INTERVAL=300
AGENT_CHAT_SLANG_ENABLED=false
# DSH -> NoneBot loopback credential, distinct from model/DSH login credentials.
AGENT_CHAT_KNOWLEDGE_TOKEN=
# Global background learning budget, separate from per-group chat/search quotas.
AGENT_CHAT_LEARNING_MAX_PER_HOUR=12
AGENT_CHAT_TAKEOVER_MENTIONS=true
# Optional safe QQ output and received forward reading; no sticker image sending.
AGENT_CHAT_REPLY_ENABLED=true
AGENT_CHAT_FACES_ENABLED=true
AGENT_CHAT_MENTIONS_ENABLED=true
AGENT_CHAT_REACTIONS_ENABLED=true
AGENT_CHAT_POKE_ENABLED=true
AGENT_CHAT_REACTION_COOLDOWN=30
AGENT_CHAT_POKE_COOLDOWN=300
AGENT_CHAT_FORWARDS_ENABLED=true
# Seed the validated persona once per session; use short reminders thereafter.
# Re-seed after detected history compaction/rewrite; progress survives bot restarts.
AGENT_CHAT_FORWARD_PERSONA=true
AGENT_CHAT_AMBIENT_PROBABILITY=0
AGENT_CHAT_COOLDOWN=2
AGENT_CHAT_DEBOUNCE=1
AGENT_CHAT_MAX_CALLS_PER_HOUR=60
# Keep every accepted direct question in a merged batch; overflow receives a notice.
AGENT_CHAT_BATCH_LIMIT=8
# One delayed waiting notice per batch, throttled per chat; 0 disables it.
AGENT_CHAT_NOTICE_AFTER=0
# Each question has its own waiting budget from admission, separate from model execution.
AGENT_CHAT_QUEUE_TIMEOUT=600
# Code default is 90s; allow a bounded 300s for slow models with native search steps.
AGENT_CHAT_TIMEOUT=300
# Leave both empty to use the model configured in DSH.
AGENT_CHAT_PROVIDER=
AGENT_CHAT_MODEL=

# AI decides when to call native web_search through the installed DSH AnySearch plugin.
# Search credentials stay in DSH. Requires the matching native-search safety preset.
# By default only direct mentions/replies/allowed private chats may search.
AGENT_CHAT_SEARCH_ENABLED=false
AGENT_CHAT_SEARCH_AMBIENT=false
AGENT_CHAT_SEARCH_PROACTIVE=false
AGENT_CHAT_SEARCH_MAX_PER_HOUR=6

# Requires a vision-capable DSH model with input: [text, image].
AGENT_CHAT_IMAGES_ENABLED=false
AGENT_CHAT_IMAGE_COUNT=2
AGENT_CHAT_IMAGE_MAX_BYTES=8000000
AGENT_CHAT_IMAGE_MAX_PIXELS=20000000
# Bounded RAM cache of normalized pixels; either 0 disables it. Separate from local path allowlist.
AGENT_CHAT_IMAGE_CACHE_TTL=600
AGENT_CHAT_IMAGE_CACHE_BYTES=32000000
# Optional exact QQ image-cache directories; [] forbids local file reads.
AGENT_CHAT_IMAGE_CACHE_ROOTS=[]

# Group-only idle speech; [] follows the main group allowlist.
AGENT_CHAT_PROACTIVE_ENABLED=false
AGENT_CHAT_PROACTIVE_GROUPS=[]
AGENT_CHAT_PROACTIVE_IDLE=900
AGENT_CHAT_PROACTIVE_DAILY_LIMIT=6
AGENT_CHAT_PROACTIVE_RECENT_HOURS=6
# Quiet hours always stop proactive speech; direct mentions stay available.
# false keeps random replies active during the same quiet hours.
AGENT_CHAT_AMBIENT_QUIET_ENABLED=true
# Set both to 0 (or any equal hours) to allow random/proactive chat all day.
AGENT_CHAT_QUIET_START=23
AGENT_CHAT_QUIET_END=9
AGENT_CHAT_UTC_OFFSET_HOURS=8
