# Copy this file to .env.agent_chat (read directly by this plugin), or use environment variables.
# .env.prod is tracked in this repository: DO NOT put credentials there.
AGENT_CHAT_ENABLED=false
AGENT_CHAT_GROUPS=[123456789]
AGENT_CHAT_PRIVATE_USERS=[]
AGENT_CHAT_DSH_URL=http://127.0.0.1:3080
# Choose one. The browser-session cookie is privileged, never share it in QQ.
AGENT_CHAT_DSH_TOKEN=
AGENT_CHAT_DSH_COOKIE=
AGENT_CHAT_STATE_PATH=data/agent_chat/state.sqlite3
AGENT_CHAT_TAKEOVER_MENTIONS=true
AGENT_CHAT_AMBIENT_PROBABILITY=0
AGENT_CHAT_COOLDOWN=8
AGENT_CHAT_DEBOUNCE=2
AGENT_CHAT_MAX_CALLS_PER_HOUR=30
AGENT_CHAT_TIMEOUT=90
# Leave both empty to use the model configured in DSH.
AGENT_CHAT_PROVIDER=
AGENT_CHAT_MODEL=
