# AI机器人配置：中文说明
# 修改保存后重启NoneBot：在项目目录运行 poetry run nb run；仅修改本文件不需重启DSH。
# 配置优先级：进程环境变量 > .env.agent_chat > NoneBot配置 > 代码默认值。
# 时间通常以秒为单位；概率0.02表示2%；群号列表必须使用JSON数组格式。
# 说明：AI插件总开关：true开启，false关闭。
AGENT_CHAT_ENABLED=false
# 说明：允许使用AI的群号；JSON数组，例如[123456789,987654321]，新增群后重启机器人。
AGENT_CHAT_GROUPS=[123456789]
# 说明：允许私聊AI的QQ号；JSON数组，[]表示不开放私聊。
AGENT_CHAT_PRIVATE_USERS=[]
# 说明：NoneBot连接DSH的本机地址，使用127.0.0.1；不是模型API地址。
AGENT_CHAT_DSH_URL=http://127.0.0.1:3080
# 说明：DSH登录凭据，与COOKIE二选一；留在本地，不是模型API Key。
AGENT_CHAT_DSH_TOKEN=
# 说明：DSH浏览器访问凭据，与TOKEN二选一；保留完整值，不在群聊中分享。
AGENT_CHAT_DSH_COOKIE=
# 说明：本地会话、额度和知识库数据库路径；日常调参不要更改，以免丢失原绑定。
AGENT_CHAT_STATE_PATH=data/agent_chat/state.sqlite3
# 说明：轻量记忆总开关，使用前需完成DSH记忆工具配置。
AGENT_CHAT_MEMORY_ENABLED=false
# 说明：即时记忆默认开关：AI可在聊天回合中记录；管理员命令的持久设置优先。
AGENT_CHAT_MEMORY_IMMEDIATE_ENABLED=true
# 说明：后台增量记忆默认开关：未触发回复的普通群聊也可进入整理；管理员命令设置优先。
AGENT_CHAT_MEMORY_BACKGROUND_ENABLED=false
# 说明：后台记忆累积多少条新文字后可整理，范围1–200；与等待时长满足其一即可。
AGENT_CHAT_MEMORY_BATCH_THRESHOLD=30
# 说明：后台记忆最早待处理消息等待多久后可整理，单位秒，范围60–86400。
AGENT_CHAT_MEMORY_INTERVAL=600
# 说明：同群后台记忆两次尝试的最短间隔，单位秒，范围30–86400。
AGENT_CHAT_MEMORY_MIN_INTERVAL=300
# 说明：黑话自主提取、理解与研究开关；需要时可使用DSH的AnySearch。
AGENT_CHAT_SLANG_ENABLED=false
# 说明：DSH调用NoneBot记忆/黑话工具的专用认证凭据；由安装脚本维护，不是模型Key。
AGENT_CHAT_KNOWLEDGE_TOKEN=
# 说明：所有群共用的后台学习上限，滚动60分钟计数，范围1–60；记忆、黑话提取/研究和失败均计入，不占群聊额度。
AGENT_CHAT_LEARNING_MAX_PER_HOUR=12
# 说明：被@时优先交给AI，避免their_ana被动语录抢答。
AGENT_CHAT_TAKEOVER_MENTIONS=true
# 说明：允许机器人自主引用当前群近期真实消息。
AGENT_CHAT_REPLY_ENABLED=true
# 说明：允许机器人发送QQ自带表情；Unicode emoji可直接用于正文。
AGENT_CHAT_FACES_ENABLED=true
# 说明：允许机器人自主@近期同群参与者，不允许@全体。
AGENT_CHAT_MENTIONS_ENABLED=true
# 说明：允许机器人给近期同群消息贴表情。
AGENT_CHAT_REACTIONS_ENABLED=true
# 说明：允许机器人向同群参与者戳一戳；与收到戳后的回应开关独立。
AGENT_CHAT_POKE_ENABLED=true
# 说明：收到别人戳机器人时，是否允许概率触发回应。
AGENT_CHAT_POKE_REPLY_ENABLED=true
# 说明：被戳后进入AI判断的概率，范围0–1；0.3表示70%直接沉默，进入判断后仍可沉默。
AGENT_CHAT_POKE_REPLY_PROBABILITY=0.3
# 说明：同一对话被戳命中后的回应冷却，单位秒，范围0–3600；0关闭额外冷却。
AGENT_CHAT_POKE_REPLY_COOLDOWN=30
# 说明：机器人主动贴表情的每群冷却，单位秒，范围5–3600。
AGENT_CHAT_REACTION_COOLDOWN=30
# 说明：机器人主动戳别人的每群冷却，单位秒，范围30–86400。
AGENT_CHAT_POKE_COOLDOWN=300
# 说明：是否读取群友发送的合并转发内容，仍受来源和长度限制。
AGENT_CHAT_FORWARDS_ENABLED=true
# 说明：首次或设定变化/历史压缩后注入人设，后续复用；true不是每轮重复发送完整人设。
AGENT_CHAT_FORWARD_PERSONA=true
# 说明：普通群聊随机接话概率，范围0–0.2；0.02=2%，0.05=5%，命中后AI仍可选择沉默。
AGENT_CHAT_AMBIENT_PROBABILITY=0
# 说明：成功发言后是否观察相关新消息并尝试续聊；无新消息时不调用模型。
AGENT_CHAT_OBSERVATION_ENABLED=false
# 说明：发送后观察窗口，单位秒，范围30–900；60表示1分钟。
AGENT_CHAT_OBSERVATION_SECONDS=120
# 说明：每个观察窗口最多进行多少轮续聊判断，范围1–10；同样占用每群小时额度。
AGENT_CHAT_OBSERVATION_MAX_CALLS=3
# 说明：同群相邻处理回合的最小启动间隔，单位秒，范围0–3600；与每小时额度不同。
AGENT_CHAT_COOLDOWN=2
# 说明：同群短时间连续消息的合并等待，单位秒，范围0–10。
AGENT_CHAT_DEBOUNCE=1
# 说明：每群独立的对话上限，滚动60分钟计数，范围1–300；@、随机、观察续聊、主动发言、沉默及失败共用，合并一批算1轮。
AGENT_CHAT_MAX_CALLS_PER_HOUR=60
# 说明：同群一批最多合并多少条直接提问，范围1–20；不是每个问题单独计一轮。
AGENT_CHAT_BATCH_LIMIT=8
# 说明：等待多少秒后提示排队，范围0–120；0表示后台默默处理，不发排队提示。
AGENT_CHAT_NOTICE_AFTER=0
# 说明：每条提问的最大排队等待，单位秒，范围5–3600；600表示10分钟，过期不会自动补答。
AGENT_CHAT_QUEUE_TIMEOUT=600
# 说明：开始调用DSH后的单轮超时，单位秒，范围5–300；与排队等待分别计算。
AGENT_CHAT_TIMEOUT=300
# 说明：固定模型的提供方ID；和MODEL同时留空则使用DSH默认选择，API Key在DSH中配置。
AGENT_CHAT_PROVIDER=
# 说明：固定模型ID；需要与PROVIDER成对设置，通常留空跟随DSH。
AGENT_CHAT_MODEL=

# 说明：是否允许群聊AI按需调用DSH AnySearch；搜索凭据由DSH管理。
AGENT_CHAT_SEARCH_ENABLED=false
# 说明：是否允许随机接话/观察续聊联网；false仅限直接提问等已允许场景。
AGENT_CHAT_SEARCH_AMBIENT=false
# 说明：是否允许闲时主动发言联网；false表示不开放该场景搜索。
AGENT_CHAT_SEARCH_PROACTIVE=false
# 说明：每群滚动60分钟最多多少个联网回合，范围1–30；搜索失败也计数，且同时占对话额度，一轮最多2次搜索工具调用。
AGENT_CHAT_SEARCH_MAX_PER_HOUR=6

# 说明：是否读取图片，需要DSH当前模型具备图像能力。
AGENT_CHAT_IMAGES_ENABLED=false
# 说明：每轮最多发送多少张图片给模型，范围1–4。
AGENT_CHAT_IMAGE_COUNT=2
# 说明：单张原图下载上限，单位字节，范围100000–20000000。
AGENT_CHAT_IMAGE_MAX_BYTES=8000000
# 说明：单张原图像素数量上限，范围100000–40000000。
AGENT_CHAT_IMAGE_MAX_PIXELS=20000000
# 说明：已处理图片的内存缓存有效期，单位秒，范围0–3600；0关闭缓存。
AGENT_CHAT_IMAGE_CACHE_TTL=600
# 说明：图片内存缓存总容量，单位字节，范围0–128000000；0关闭缓存。
AGENT_CHAT_IMAGE_CACHE_BYTES=32000000
# 说明：允许读取的本地QQ图片缓存目录，JSON数组；[]禁止本地图片文件读取，不要填不受信任目录。
AGENT_CHAT_IMAGE_CACHE_ROOTS=[]

# 说明：闲时自主发言开关，与随机接话开关分别生效。
AGENT_CHAT_PROACTIVE_ENABLED=false
# 说明：允许闲时自主发言的群号子集；[]沿用GROUPS全部群，不能超出GROUPS。
AGENT_CHAT_PROACTIVE_GROUPS=[]
# 说明：群内安静多久后可尝试主动说话，单位秒，范围60–86400；900表示15分钟。
AGENT_CHAT_PROACTIVE_IDLE=900
# 说明：每群每天最多几次闲时主动尝试，范围1–24；沉默/失败也算，按下方时区零点刷新，同时占对话小时额度。
AGENT_CHAT_PROACTIVE_DAILY_LIMIT=6
# 说明：只在最近多少小时内活跃过的群尝试闲时发言，范围1–24。
AGENT_CHAT_PROACTIVE_RECENT_HOURS=6
# 说明：夜间是否也限制随机接话；false仅停止闲时主动发言，随机接话继续按概率触发。
AGENT_CHAT_AMBIENT_QUIET_ENABLED=true
# 说明：夜间安静时段起始小时，范围0–23；与结束小时相同表示关闭时段限制。
AGENT_CHAT_QUIET_START=23
# 说明：夜间安静时段结束小时，范围0–23；23到9表示跨午夜至次日09:00。
AGENT_CHAT_QUIET_END=9
# 说明：安静时段和每日主动次数的时区偏移，范围-12–14；8表示北京时间。
AGENT_CHAT_UTC_OFFSET_HOURS=8
